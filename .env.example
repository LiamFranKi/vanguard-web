# ============================================================
# Variables de MySQL para la web Vanguard (NO subir a GitHub)
# ============================================================
# Ubica este archivo en el VPS:
#   /home/vanguard/web-vanguard/.env
#
# Si YA tienes un .env (con SMTP), SOLO AGREGA las líneas MYSQL_
# al final del archivo existente. No borres SMTP ni SITE_URL.
# ============================================================

# --- SMTP (ejemplo; usa los que ya tienes) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_app_password
# NEXT_PUBLIC_SITE_URL=https://www.vanguardschools.com
# NODE_ENV=production

# --- MySQL (misma BD que la intranet en este VPS) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=vanguard
MYSQL_PASSWORD=PON_AQUI_TU_PASSWORD
MYSQL_DATABASE=vanguard_intranet

# --- Aviso a ADMINISTRADORES en la intranet (campanita + push) ---
# Debe coincidir con WEB_FORMULARIO_WEBHOOK_SECRET del backend de la intranet.
INTRANET_API_URL=http://127.0.0.1:5000
WEB_FORMULARIO_WEBHOOK_SECRET=cambia_este_secreto_compartido
